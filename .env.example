# Copy this file to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Comma-separated Telegram user IDs that get admin-panel access.
ADMIN_IDS=111111111,222222222

TIMEZONE=Europe/Moscow

# Postgres connection string (asyncpg driver). The docker-compose.yml in
# this repo starts Postgres on 127.0.0.1:5433 with these dev credentials -
# change POSTGRES_PASSWORD in docker-compose.yml (and here) before any
# real deployment.
DATABASE_URL=postgresql+asyncpg://psybot_user:psybot_dev_password_2026@127.0.0.1:5433/psybot

# YooKassa (https://yookassa.ru) - leave blank to disable real payments
# (booking creation for a priced consultation will fail with a clear log
# message instead of silently succeeding without charging anyone).
YOOKASSA_PROVIDER_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Where YooKassa redirects the client back to after paying.
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# HTTP server that receives YooKassa's webhook (payment.succeeded /
# payment.canceled). Must be reachable at the URL configured in the
# YooKassa dashboard - typically behind a reverse proxy with TLS.
PAYMENT_SERVER_HOST=0.0.0.0
PAYMENT_SERVER_PORT=8080

# Not currently used to generate anything automatically (see README.md's
# "Meeting links" section) - kept only as a suggested service to mention
# to psychologists who ask what to use for the manual link they enter.
JITSI_BASE_URL=https://meet.jit.si

# The free "help me choose" consultation - always 15 minutes, always
# price 0 (see app/services/selection_15.py). Change the duration only if
# the product decision changes; there is no price setting here on purpose.
SELECTION_15_DURATION=15

# Reminder windows in minutes-before-start (see app/services/reminders.py
# for why this is a window, not a single cutoff).
REMINDER_1H_MIN=55
REMINDER_1H_MAX=65
REMINDER_10M_MIN=7
REMINDER_10M_MAX=12

# Platform's cut of each paid booking, as a whole percent. Never applied
# to the free consultation.
# PLACEHOLDER VALUE - not a confirmed business figure. Set the real
# commission percent here once the business owner has decided it.
PLATFORM_COMMISSION_PERCENT=30

# Video meeting links (see app/services/jitsi.py). Every newly-paid (or
# free 15-minute) booking automatically gets a free meet.jit.si link if
# the psychologist hasn't already added their own manually - no API key,
# no account, and no configuration needed here. A manual link the
# psychologist sets in their cabinet ("Добавить/изменить ссылку встречи")
# always wins and is never overwritten. This replaces the earlier Yandex
# Telemost integration, which depended on a Yandex 360 for Business OAuth
# token that never materialized in practice.
